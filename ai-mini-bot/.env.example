# Copy this file to ".env" and fill in your own keys.
# Never commit your real .env — it's already in .gitignore.

# OpenAI key WITH Realtime API access (the thinking + hearing)
OPENAI_API_KEY=your-openai-key-here

# ElevenLabs key (the voice) — a cloned voice via API needs a paid plan
ELEVENLABS_API_KEY=your-elevenlabs-key-here
